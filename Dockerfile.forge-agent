FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/forge-agent ./cmd/forge-agent

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/forge-agent /app/forge-agent
EXPOSE 8081
ENTRYPOINT ["/app/forge-agent"]
